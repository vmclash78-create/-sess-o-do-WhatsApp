PORT=3001
SESSION_PATH=./session_data
# Descomente a linha abaixo e defina sua chave secreta para proteger as rotas
# API_KEY=sua-chave-secreta-aqui
ALLOWED_ORIGIN=*
# URL que receberá os eventos em tempo real (connection, qr, message, queue)
# WEBHOOK_URL=https://seu-site.com/webhook
# Chave secreta enviada no header x-webhook-secret para validar a origem
# WEBHOOK_SECRET=sua-chave-webhook-aqui

